# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF)  Project Minimal Configuration
#
CONFIG_IDF_TARGET="esp32"
CONFIG_IDF_TARGET_ESP32=y
CONFIG_IDF_FIRMWARE_CHIP_ID=0x0000
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="targets/ESP32/_IDF/${TARGET_SERIES_SHORT}/partitions_nanoclr_4mb.csv"

CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=y

# Suppress warning for using old api for now
CONFIG_ADC_SUPPRESS_DEPRECATE_WARN=y
CONFIG_ADC_CALI_SUPPRESS_DEPRECATE_WARN=y
CONFIG_PCNT_SUPPRESS_DEPRECATE_WARN=y
CONFIG_I2S_SUPPRESS_DEPRECATE_WARN=y
CONFIG_DAC_SUPPRESS_DEPRECATE_WARN=y

CONFIG_UART_ISR_IN_IRAM=y

CONFIG_ETH_SPI_ETHERNET_DM9051=y
CONFIG_ETH_SPI_ETHERNET_W5500=y
CONFIG_ETH_SPI_ETHERNET_KSZ8851SNL=y
CONFIG_ESP_SLEEP_POWER_DOWN_FLASH=y

CONFIG_PM_ENABLE=y

CONFIG_ESP_TASK_WDT_INIT=n
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_1=y
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=n

CONFIG_FATFS_LFN_HEAP=y

CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=2304
CONFIG_FREERTOS_TIMER_TASK_PRIORITY=5
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y

CONFIG_LWIP_LOCAL_HOSTNAME="nanodevice"
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_SO_LINGER=y
CONFIG_LWIP_SO_RCVBUF=y
CONFIG_LWIP_DHCP_OPTIONS_LEN=80
# MiniRover: the car's own access point (setup mode, play mode) must hand out addresses. Upstream nanoFramework
# turns ESP-IDF's DHCP server off and leaves it to a managed server; the native one costs no CLR time or heap.
# Measured: with it off, a PC joined the car's WPA2 network but never got an address (169.254.x).
CONFIG_LWIP_DHCPS=y
CONFIG_LWIP_DHCPS_MAX_STATION_NUM=4
CONFIG_LWIP_IPV6=y
CONFIG_LWIP_MAX_LISTENING_TCP=8
CONFIG_LWIP_SNTP_MAX_SERVERS=2
CONFIG_LWIP_TCP_SYNMAXRTX=4

CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y
CONFIG_MBEDTLS_SSL_VARIABLE_BUFFER_LENGTH=y
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n
CONFIG_MBEDTLS_CMAC_C=y
CONFIG_MBEDTLS_HAVE_TIME_DATE=y
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_DES_C=y
CONFIG_MBEDTLS_XTEA_C=n
CONFIG_MBEDTLS_PEM_WRITE_C=y
CONFIG_MBEDTLS_X509_CSR_PARSE_C=n
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=n
CONFIG_MBEDTLS_CLIENT_SSL_SESSION_TICKETS=y
CONFIG_MBEDTLS_SSL_TLS1_3_COMPATIBILITY_MODE=y
CONFIG_MBEDTLS_SSL_TLS1_3_KEXM_PSK=y
CONFIG_MBEDTLS_SSL_TLS1_3_KEXM_EPHEMERAL=y
CONFIG_MBEDTLS_SSL_TLS1_3_KEXM_PSK_EPHEMERAL=y
CONFIG_MBEDTLS_SSL_ALPN=y

CONFIG_SPI_FLASH_SUPPORT_BOYA_CHIP=y

CONFIG_LITTLEFS_MAX_PARTITIONS=1
CONFIG_LITTLEFS_OBJ_NAME_LEN=256
CONFIG_LITTLEFS_OPEN_DIR=y
CONFIG_LITTLEFS_FCNTL_GET_PATH=y

# remove this following the migration to the new API, but for now we need to suppress the warning
CONFIG_TOUCH_SUPPRESS_DEPRECATE_WARN=y

# ---------------------------------------------------------------------------------------------
# MiniRover (Freenove FNK0053, ESP32-WROVER 4MB flash / 8MB PSRAM) additions
# ---------------------------------------------------------------------------------------------
# Full speed: the stock generic image runs at 160 MHz.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# lwIP + WiFi buffers in PSRAM so WebRTC (DTLS/SCTP) reconnects do not starve internal RAM
# (SpawnWear found socket() starving without this).
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# libpeer WebRTC: DTLS 1.2 only (TLS 1.3 hijacked the DTLS path on SpawnWear), self-signed cert
# generation, large handshake allocations in PSRAM, deep pthread stacks for mbedTLS.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192

# BLE (NimBLE) for setup/pairing from the web app - same settings as the stock ESP32 BLE targets.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_SVC_GAP_DEVICE_NAME="MiniRover"
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=10
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=20

# Camera head (esp32-camera, vendored in MiniRover firmware/native/components): only the two sensors Freenove ships.
CONFIG_OV2640_SUPPORT=y
CONFIG_GC0308_SUPPORT=y
CONFIG_OV7670_SUPPORT=n
CONFIG_OV7725_SUPPORT=n
CONFIG_NT99141_SUPPORT=n
CONFIG_OV3660_SUPPORT=n
CONFIG_OV3640_SUPPORT=n
CONFIG_OV5640_SUPPORT=n
CONFIG_GC2145_SUPPORT=n
CONFIG_GC032A_SUPPORT=n
CONFIG_BF3005_SUPPORT=n
CONFIG_BF20A6_SUPPORT=n
CONFIG_SC101IOT_SUPPORT=n
CONFIG_SC030IOT_SUPPORT=n
CONFIG_SC031GS_SUPPORT=n
CONFIG_HM1055_SUPPORT=n
CONFIG_HM0360_SUPPORT=n
CONFIG_MEGA_CCM_SUPPORT=n
# nanoFramework's I2C uses the LEGACY driver on port 0; IDF aborts if legacy and new drivers are mixed.
CONFIG_SCCB_HARDWARE_I2C_DRIVER_LEGACY=y
CONFIG_SCCB_HARDWARE_I2C_PORT1=y
CONFIG_CAMERA_NO_AFFINITY=y
# IRAM: the camera's DMA/VSYNC interrupt code overflowed iram0 by 908 bytes. FreeRTOS functions that are not called
# from cache-disabled contexts move to flash (IDF-supported); WiFi IRAM optimisations were already off.
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y

# Internal RAM budget (measured 2026-10-06, internal free: 74 KB after boot, 31 KB after the camera, 2 KB after BLE,
# then WebRTC could not start). PSRAM had 276 KB spare. Move what can live in PSRAM there:
# - NimBLE host allocations to PSRAM; one BLE connection is all setup needs.
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_INTERNAL=n
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BTDM_CTRL_BLE_MAX_CONN=1
# - plain malloc() of 4 KB or more goes to PSRAM (default 16 KB kept libpeer/mbedTLS/NimBLE buffers internal);
#   drivers that need internal or DMA memory ask for it explicitly with heap_caps_malloc.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
# - camera DMA line buffers 16 KB -> 8 KB (internal, DMA-capable).
CONFIG_CAMERA_DMA_BUFFER_SIZE_MAX=8192
# - task stacks in PSRAM for tasks that never run with the flash cache off (the WebRTC pump, 16 KB): play mode keeps
#   BLE on beside the session, and the pump's internal stack left 4 KB internal free (WiFi then dropped packets).
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y

