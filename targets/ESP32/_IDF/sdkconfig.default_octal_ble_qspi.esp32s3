# SDK config for ESP32-S3 with octal PSRAM + QSPI graphics target (SpawnWear watch).
# Branched from sdkconfig.default_octal_ble.esp32s3 with three additions
# pulled from the Waveshare LVGL vendor demo (frees ~1MB of internal SRAM by
# moving instructions + read-only data into PSRAM, doubles PSRAM bandwidth):
#
#   CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y   # XIP code from PSRAM
#   CONFIG_SPIRAM_RODATA=y               # rodata segment in PSRAM
#   CONFIG_SPIRAM_SPEED_80M=y            # 80 MHz vs default 40 MHz
#
# Plus CONFIG_LOG_DEFAULT_LEVEL_INFO=y so Memory.cpp's ESP_LOGI managed-heap
# size report shows up in the COM9 boot console - we need that visibility
# while bringing the panel up.

CONFIG_IDF_CMAKE=y
CONFIG_IDF_TARGET_ARCH_XTENSA=y
CONFIG_IDF_TARGET="esp32s3"

# Deprecated drivers, disable warnings on build
CONFIG_ADC_SUPPRESS_DEPRECATE_WARN=y
CONFIG_ADC_CALI_SUPPRESS_DEPRECATE_WARN=y
CONFIG_UART_ISR_IN_IRAM=y
CONFIG_PCNT_SUPPRESS_DEPRECATE_WARN=y
CONFIG_RMT_SUPPRESS_DEPRECATE_WARN=y
CONFIG_I2S_SUPPRESS_DEPRECATE_WARN=y

# Watch flash is 32 MB, but the nanoframework partition layout still slots into 4 MB
# 2026-06-21: bumped 4 MB -> 16 MB (the watch's flash; vendor demos use 16 MB) so
# the factory/NanoCLR partition can grow to hold native crypto (Monocypher Ed25519/
# X25519) and the coming WebRTC/audio native. nf reads partition offsets from the
# table at runtime (FixUpBlockRegionInfo), so no BlockRegions edit is needed.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="targets/ESP32/_IDF/esp32s3/partitions_nanoclr_16mb.csv"

CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=y

CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_SVC_GAP_DEVICE_NAME="nanoBLE"
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=10
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=20
CONFIG_BT_NIMBLE_HS_FLOW_CTRL=y
CONFIG_BT_CTRL_BLE_MAX_ACT=10

CONFIG_PM_ENABLE=y

# PSRAM - octal 8MB, full vendor optimization profile
CONFIG_SPIRAM=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
# CONFIG_SPIRAM_FETCH_INSTRUCTIONS and CONFIG_SPIRAM_RODATA were tried 2026-05-03
# and resulted in graphics-heap being capped at ~100KB - PSRAM was consumed by
# the .text + .rodata copy before user code got a chance to claim heap. We do
# not need the perf bump those provide; nf-interpreter XIP-from-flash is fine.
# CONFIG_SPIRAM_FETCH_INSTRUCTIONS is not set
# CONFIG_SPIRAM_RODATA is not set
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

CONFIG_ESP_TASK_WDT_INIT=n

CONFIG_ESP_IPC_TASK_STACK_SIZE=1024

CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_RX_BA_WIN=6

CONFIG_FATFS_LFN_HEAP=y

CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=2304
CONFIG_FREERTOS_TIMER_TASK_PRIORITY=5
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y

# Boot logs at INFO so we can see Memory.cpp's "Managed heap allocated: N (from max:M)"
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

CONFIG_LWIP_LOCAL_HOSTNAME="nanodevice"
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_SO_LINGER=y
CONFIG_LWIP_SO_RCVBUF=y
CONFIG_LWIP_DHCP_OPTIONS_LEN=80
CONFIG_LWIP_DHCPS=n
CONFIG_LWIP_IPV6=n
CONFIG_LWIP_MAX_LISTENING_TCP=8
CONFIG_LWIP_SNTP_MAX_SERVERS=2
CONFIG_LWIP_TCP_SYNMAXRTX=4

CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y
CONFIG_MBEDTLS_SSL_VARIABLE_BUFFER_LENGTH=y
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n
CONFIG_MBEDTLS_HAVE_TIME_DATE=y
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_DES_C=y
CONFIG_MBEDTLS_XTEA_C=n
CONFIG_MBEDTLS_PEM_WRITE_C=n
CONFIG_MBEDTLS_X509_CSR_PARSE_C=n
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=y
CONFIG_MBEDTLS_CLIENT_SSL_SESSION_TICKETS=y

CONFIG_LITTLEFS_MAX_PARTITIONS=1
CONFIG_LITTLEFS_OBJ_NAME_LEN=256
CONFIG_LITTLEFS_OPEN_DIR=y
CONFIG_LITTLEFS_FCNTL_GET_PATH=y

CONFIG_TOUCH_SUPPRESS_DEPRECATE_WARN=y

CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_DESC_PRODUCT_STRING="nanoFramework device"
CONFIG_TINYUSB_DESC_CDC_STRING="nanoFramework device"
CONFIG_TINYUSB_CDC_TX_BUFSIZE=1024
CONFIG_TINYUSB_TASK_AFFINITY=TINYUSB_TASK_AFFINITY_CPU0
